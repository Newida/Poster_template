% Gemini theme
% https://github.com/anishathalye/gemini

% ====================
% Theme
% ====================

% Basic colors
\setbeamercolor{palette primary}{fg=DarkNavy,bg=CrispWhite}
\setbeamercolor{palette secondary}{fg=DarkNavy,bg=CrispWhite}
\setbeamercolor{palette tertiary}{bg=DarkNavy,fg=CrispWhite}
\setbeamercolor{palette quaternary}{fg=DarkNavy,bg=CrispWhite}
\setbeamercolor{structure}{fg=Aqua}

% Headline
\setbeamercolor{headline}{fg=CrispWhite,bg=DarkNavy}
\setbeamercolor{headline title}{fg=CrispWhite}
\setbeamercolor{headline author}{fg=CrispWhite}
\setbeamercolor{headline institute}{fg=CrispWhite}
\setbeamercolor{headline rule}{bg=Aqua}

% Block
\setbeamercolor{block title}{fg=DarkNavy,bg=CrispWhite}
\setbeamercolor{block separator}{bg=Aqua}
\setbeamercolor{block body}{fg=DarkNavy,bg=CrispWhite}

% Alert Block
\setbeamercolor{block alerted title}{fg=DarkNavy,bg=SkyBlue}
\setbeamercolor{block alerted separator}{bg=Aqua}
\setbeamercolor{block alerted body}{fg=DarkNavy,bg=SkyBlue}

% Example Block
\setbeamercolor{block example title}{fg=DarkNavy,bg=Caribbean}
\setbeamercolor{block example separator}{bg=Aqua}
\setbeamercolor{block example body}{fg=DarkNavy,bg=CrispWhite}

% Heading
\setbeamercolor{heading}{fg=DarkNavy}

% Itemize
\setbeamercolor{item}{fg=Aqua}

% Bibliography
\setbeamercolor{bibliography item}{fg=DarkNavy}
\setbeamercolor{bibliography entry author}{fg=DarkNavy}
\setbeamercolor{bibliography entry title}{fg=DarkNavy}
\setbeamercolor{bibliography entry location}{fg=DarkNavy}
\setbeamercolor{bibliography entry note}{fg=DarkNavy}
